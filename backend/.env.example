# Copy to .env and fill in for real vision recognition.
# Leave GEMINI_API_KEY unset to run against the mock vision adapter (no key needed).
GEMINI_API_KEY=
DATABASE_URL=
# Shared admin email+password gating /admin -- required to log in to the admin section.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Postgres connection string (Neon, Supabase, or any Postgres) for the
# escalated-tickets table. If the password contains special characters,
# percent-encode them (e.g. "@" -> "%40").
DATABASE_URL=
